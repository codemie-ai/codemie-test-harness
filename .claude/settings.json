{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.prod*)",
      "Read(**/.env.preview)",
      "Read(**/.env.sandbox)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Read(~/.codemie/**)",
      "Edit(~/.codemie/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.pypirc)",
      "Edit(**/poetry.lock)",
      "Write(**/poetry.lock)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git commit*--no-verify*)",
      "Bash(* --no-verify*)",
      "Bash(poetry publish*)",
      "Bash(make publish*)",
      "Bash(twine upload*)",
      "Bash(uv publish*)",
      "Bash(gh release create*)",
      "Bash(gh workflow run publish*)",
      "Bash(*pytest*cleanup.py*)",
      "Bash(*pytest*-m cleanup*)",
      "Bash(*pytest*test_clean_all_entities*)",
      "Bash(*codemie-test-harness*cleanup*)"
    ]
  }
}
