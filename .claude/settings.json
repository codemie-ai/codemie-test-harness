{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Read(/**/.env.*.local)",
      "Read(/**/.env.prod*)",
      "Read(/**/.env.dev*)",
      "Read(/**/.env.stag*)",
      "Read(/**/.env.uat*)",
      "Read(/**/.env.qa*)",
      "Read(/**/.env.test*)",
      "Read(/**/*.env)",
      "Read(/**/.envrc)",
      "Read(/**/.env.preview)",
      "Read(/**/.env.sandbox)",
      "Edit(/**/.env)",
      "Edit(/**/.env.local)",
      "Edit(/**/.env.*.local)",
      "Edit(/**/.env.prod*)",
      "Edit(/**/.env.dev*)",
      "Edit(/**/.env.stag*)",
      "Edit(/**/.env.uat*)",
      "Edit(/**/.env.qa*)",
      "Edit(/**/.env.test*)",
      "Edit(/**/*.env)",
      "Edit(/**/.envrc)",
      "Edit(/**/.env.preview)",
      "Edit(/**/.env.sandbox)",
      "Read(~/.codemie/**)",
      "Edit(~/.codemie/**)",
      "Read(/**/*.pem)",
      "Read(/**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.pypirc)",
      "Bash(*--show-value*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean *-*x*)",
      "Bash(git clean *-*X*)",
      "Bash(* --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(*core.hooksPath*)",
      "Bash(*poetry publish*)",
      "Bash(make publish*)",
      "Bash(make *publish*)",
      "Bash(*twine upload*)",
      "Bash(*uv publish*)",
      "Bash(*pytest*cleanup.py*)",
      "Bash(*pytest*-m cleanup*)",
      "Bash(*pytest*test_clean_all_entities*)",
      "Bash(*codemie-test-harness run*cleanup.py*)",
      "Bash(*codemie-test-harness run*test_clean_all_entities*)",
      "Bash(*codemie-test-harness run*--marks cleanup*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(rm *)",
      "Bash(find * -delete*)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(gh release edit*)",
      "Bash(gh workflow run *)",
      "Edit(/.github/workflows/**)",
      "Edit(/.gitleaks.toml)",
      "Edit(/.claude/settings.json)",
      "Edit(/**/poetry.lock)"
    ]
  }
}
